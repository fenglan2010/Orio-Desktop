# Keep images lean and secret-free. Do not copy local data or credentials.
.git
.gitignore
.venv
**/.venv
**/__pycache__
**/*.pyc
**/*.pyo
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
frontend/node_modules
frontend/dist
data/*.db
data/*.db-journal
data/*.langgraph.db
data/pg-test/
.env
.env.*
!.env.example
deploy/compose.env
deploy/k8s/**/secret.yaml
*.pem
*.key
id_rsa*
backend/tests
backend/.pytest_cache
docs
