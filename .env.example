# OIRO environment template. Copy to .env and fill in keys if you have them.
# Without any keys the app still runs, using the deterministic mock model.

# Local default stays SQLite. Do not point the shared demo process at Postgres
# unless you intend to. Passwords in this URL must never be committed or logged.
# DATABASE_URL=sqlite:////workspace/oiro/data/oiro.db
#
# PostgreSQL (psycopg 3). For 腾讯云 TencentDB / 阿里云 RDS PostgreSQL, use the
# private-network (VPC) endpoint first, and require TLS:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@PRIVATE_HOST:5432/oiro?sslmode=require
# If the cloud vendor gives you a CA file, prefer sslmode=verify-ca or verify-full
# with sslrootcert=/path/to/ca.pem. Do not invent or hard-code a cloud hostname here.
#
# The default JWT_SECRET below is for local demo only. Change it before any
# cloud deploy. When OIRO_ENV=production the process refuses this demo value
# and also refuses to use SQLite (set a PostgreSQL DATABASE_URL instead).
# Leave OIRO_ENV unset for local scripts/dev.sh.
# OIRO_ENV=development
JWT_SECRET=oiro-demo-secret-change-me

# Domestic primary / backup. Leave blank to skip and degrade to Mock.
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat

QWEN_API_KEY=
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen-plus

# Overseas adapters are reserved and default off.
# Even if OVERSEAS_ENABLED=true, pricing_strategy and review_reply never go overseas.
OVERSEAS_ENABLED=false
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
GROK_API_KEY=
# GROK_BASE_URL=https://api.x.ai/v1
# GROK_MODEL=grok-2-latest

# LLM_TIMEOUT_SECONDS=20
# LLM_RATE_LIMIT_PER_MINUTE=30
# LLM_VENDOR_CONCURRENCY=4
# LLM_GLOBAL_CONCURRENCY=8
# LLM_QUEUE_WAIT_SECONDS=5
# LLM_CIRCUIT_FAILURE_THRESHOLD=3
# LLM_CIRCUIT_COOLDOWN_SECONDS=30
#
# Per-task preference overrides (comma-separated vendors). Empty = documented default.
# Critical tasks cannot include overseas vendors even if listed.
# LLM_TASK_PREF_ANALYSIS=
# LLM_TASK_PREF_PRICING_STRATEGY=
# LLM_TASK_PREF_REVIEW_REPLY=
# LLM_TASK_PREF_ASSISTANT_CHAT=
# LLM_TASK_PREF_VISION_OR_LONGDOC=
#
# Reserved self-hosted open-source model (OpenAI-compatible, in-country).
# Leave all three empty until you actually deploy one on 腾讯云 / 阿里云, then
# fill them to enable. Do not invent a production host. Default is disabled.
# SELF_HOSTED_BASE_URL=
# SELF_HOSTED_API_KEY=
# SELF_HOSTED_MODEL=

# Official OTA write (server only, never expose to the hotel UI).
# Live HTTP is sent only when the channel is authorized, credentials exist,
# the platform write flag is on, and an official contract is configured.
# Do not enable these on the default demo process.
# CTRIP_WRITE_ENABLED=false
# CTRIP_WRITE_KEY=
# CTRIP_WRITE_SECRET=
# CTRIP_HOTEL_ID=
# MEITUAN_WRITE_ENABLED=false
# MEITUAN_WRITE_KEY=
# MEITUAN_WRITE_SECRET=
# FLIGGY_WRITE_ENABLED=false
# FLIGGY_WRITE_KEY=
# FLIGGY_WRITE_SECRET=
# Official contract JSON (base_url + auth + path + mapping). Not shipped with
# production Ctrip/Meituan/Fliggy URLs; see docs/official-contracts/.
# OIRO_OFFICIAL_CONTRACT_DIR=
# OIRO_OFFICIAL_CONTRACT_CTRIP=
# OIRO_OFFICIAL_CONTRACT_MEITUAN=
# OIRO_OFFICIAL_CONTRACT_FLIGGY=
# Official PMS/CRS contracts (ops backend only). Never invent production
# Opera/Cloudbeds/Mews hosts. Examples in docs/official-contracts/pms/ are
# not auto-loaded. Read/write switches default off.
# OIRO_OFFICIAL_PMS_CONTRACT_DIR=
# OIRO_OFFICIAL_PMS_CONTRACT=
# OIRO_OFFICIAL_CRS_CONTRACT=
# PMS_READ_ENABLED=false
# CRS_READ_ENABLED=false
# PMS_WRITE_ENABLED=false
# CRS_WRITE_ENABLED=false
# Official e-sign contracts (ops backend only). Never invent production
# e-sign or payment-provider hosts. Examples in
# docs/official-contracts/esign/ are not auto-loaded. Vendor switch defaults off.
# OIRO_OFFICIAL_ESIGN_CONTRACT_DIR=
# OIRO_OFFICIAL_ESIGN_CONTRACT=
# ESIGN_ENABLED=false
# OIRO_CREDENTIALS_KEY=

# Background job queue. Leave brokers empty to use the local standalone worker
# (python -m app.jobs.worker or bash scripts/worker.sh). API and frontend still
# run if the worker is not started. Never log these URLs; they may contain
# passwords. Redis/Celery settings are not shown on the hotel Settings page.
# CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# REDIS_URL=redis://127.0.0.1:6379/0
# OIRO_JOB_QUEUE=auto
# auto: Celery when a broker is set, otherwise the local worker; local; celery; off.
# Conservative defaults: ingest every 30 minutes, write retry every 2 minutes,
# reconcile every 5 minutes. Retry/reconcile run more often than ingest.
# OIRO_INGEST_INTERVAL_SECONDS=1800
# OIRO_WRITE_RETRY_INTERVAL_SECONDS=120
# OIRO_RECONCILE_INTERVAL_SECONDS=300
# OIRO_JOB_STARTUP_DELAY_SECONDS=5
# Set OIRO_DEV_WORKER=0 to keep scripts/dev.sh from starting the local worker.
#
# Reproducible deploy (Compose / Kubernetes) is documented in
# docs/09-第三阶段.md and deploy/README.md. Copy deploy/compose.env.example
# to deploy/compose.env for the production-shaped stack; do not point the
# shared local demo (scripts/dev.sh) at Compose Postgres.
