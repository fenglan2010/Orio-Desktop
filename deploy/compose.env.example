# Copy to deploy/compose.env and fill in values. Do not commit the copy.
# Start the production-shaped stack with:
#   docker compose --env-file deploy/compose.env up -d --build
#
# This stack publishes only on 127.0.0.1 (default web 8080, API 18000).
# It does not replace the local SQLite demo on 127.0.0.1:5173 / 8000.
# Use URL-safe (alphanumeric) passwords here so they can be interpolated
# into DATABASE_URL without encoding issues.

# Required. Do not use the local-demo value oiro-demo-secret-change-me.
JWT_SECRET=replace-with-a-long-random-string

# Required. Used by the Compose Postgres service and interpolated into DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-strong-password

# Optional. Defaults below match docker-compose.yml.
# OIRO_ENV=production
# OIRO_WEB_PORT=8080
# OIRO_API_PORT=18000
# POSTGRES_USER=oiro
# POSTGRES_DB=oiro
#
# Cloud production should not use the in-compose Postgres/Redis as the source
# of truth. Prefer 腾讯云 TencentDB / 阿里云 RDS PostgreSQL and managed Redis
# in a VPC, with DATABASE_URL sslmode=require (or verify-ca / verify-full).
