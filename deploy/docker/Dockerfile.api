# OIRO API / Celery image. Runs as non-root. Do not copy .env or data/*.db.
FROM python:3.13-slim

RUN useradd --create-home --uid 10001 --shell /usr/sbin/nologin oiro

WORKDIR /opt/oiro
COPY backend/requirements.txt /opt/oiro/backend/requirements.txt
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r /opt/oiro/backend/requirements.txt

COPY backend/app /opt/oiro/backend/app
RUN mkdir -p /opt/oiro/data && chown -R oiro:oiro /opt/oiro

USER 10001:10001
ENV PYTHONPATH=/opt/oiro/backend \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /opt/oiro/backend
EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=25s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/health', timeout=3)"

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
