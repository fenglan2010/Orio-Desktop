# Copy to secret.yaml (gitignored) or create the Secret from a cloud
# secret manager. Placeholders only — never commit real keys, passwords,
# hostnames of a live account, or the demo JWT_SECRET.
#
#   kubectl -n oiro apply -f secret.yaml
#
# Preferred sources: 腾讯云密钢管理 / 阿里云凭据管家 or KMS, then mount or
# sync into this Secret. The application does not call a vendor secret API
# in this increment.
#
# DATABASE_URL should use the VPC address of 腾讯云 TencentDB or 阿里云 RDS
# and include sslmode=require (or verify-ca / verify-full + sslrootcert).
# Broker URLs should point at managed Redis in the same VPC.
apiVersion: v1
kind: Secret
metadata:
  name: oiro-secrets
  labels:
    app.kubernetes.io/name: oiro
    app.kubernetes.io/part-of: oiro
type: Opaque
stringData:
  JWT_SECRET: "REPLACE_WITH_LONG_RANDOM_SECRET"
  DATABASE_URL: "postgresql+psycopg://USER:PASSWORD@PRIVATE_HOST:5432/oiro?sslmode=require"
  CELERY_BROKER_URL: "redis://:PASSWORD@PRIVATE_HOST:6379/0"
  REDIS_URL: "redis://:PASSWORD@PRIVATE_HOST:6379/0"
  DEEPSEEK_API_KEY: ""
  QWEN_API_KEY: ""
  OIRO_CREDENTIALS_KEY: ""
